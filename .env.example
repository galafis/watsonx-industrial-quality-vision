# IBM Watsonx Configuration
WATSONX_API_KEY=your_ibm_cloud_api_key
WATSONX_PROJECT_ID=your_watsonx_project_id
WATSONX_URL=https://us-south.ml.cloud.ibm.com

# Model Configuration
WATSONX_GENERATION_MODEL=ibm/granite-13b-chat-v2
DETECTION_MODEL_PATH=models/yolov8_defects.pt
CLASSIFICATION_MODEL_PATH=models/efficientnet_severity.pt

# Inference Configuration
CONFIDENCE_THRESHOLD=0.5
NMS_THRESHOLD=0.45
MAX_IMAGE_SIZE=1280
DEVICE=cpu

# ONNX Edge Deployment
ONNX_DETECTOR_PATH=models/yolov8_defects.onnx
ONNX_CLASSIFIER_PATH=models/efficientnet_severity.onnx

# Application Configuration
APP_HOST=0.0.0.0
APP_PORT=8080
LOG_LEVEL=INFO
ENVIRONMENT=development

# Governance
GOVERNANCE_ENABLED=true
GOVERNANCE_LOG_PATH=./logs/governance
ACCURACY_THRESHOLD=0.85
SHIFT_DEGRADATION_THRESHOLD=0.10
